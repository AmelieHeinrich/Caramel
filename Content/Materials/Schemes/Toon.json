{
    "name": "Toon",
    "shader": "Content/Shaders/Toon.hlsl",
    "renderState": {
        "fillMode": "Solid",
        "cullMode": "None",
        "frontFace": "CounterClockwise",
        "topology": "Triangles",
        "depthTest": true,
        "depthWrite": true,
        "depthCompare": "Less",
        "blend": "None"
    },
    "flags": {
        "castsShadows": true,
        "receivesShadows": true
    },
    "parameters": [
        { "name": "brightness", "type": "float",  "default": 1.0,                 "min": 0.0, "max": 4.0 },
        { "name": "bandCount",  "type": "int",    "default": 3.0,                 "min": 1.0, "max": 16.0 },
        { "name": "rimColor",   "type": "float4", "default": [1.0, 0.8, 0.4, 0.0], "color": true },
        { "name": "rimPower",   "type": "float",  "default": 4.0,                 "min": 1.0, "max": 16.0 }
    ]
}
